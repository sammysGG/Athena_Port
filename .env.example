PORT_SITE_NAME=Tallinna Sadam

# Operator login. Set both before first boot; the container refuses to start
# if either is missing or PORT_OPERATOR_PASSWORD is shorter than 8 chars.
PORT_OPERATOR_USERNAME=operator
PORT_OPERATOR_PASSWORD=Cool2Pass

# 32+ byte hex secret used to sign session cookies. Rotate to invalidate
# all live sessions. Run ./scripts/generate-secrets.sh to populate.
PORT_SESSION_SECRET=CHANGE_ME

# Simulation tuning
PORT_TICK_SECONDS=1.0
PORT_BERTHS=4
PORT_CRANES_PER_BERTH=2
# Ticks a single crane move takes from hook-on to set-down.
# Higher = slower (more realistic-looking lifts); lower = bigger throughput.
PORT_CRANE_CYCLE_TICKS=5

# Bind only to localhost so the existing Cloudflare tunnel is the only path
# in. Set to 0.0.0.0 only if you want to expose the port directly.
PORT_BIND_ADDRESS=127.0.0.1
PORT_PUBLISHED_PORT=18090

# When 1, trust X-Forwarded-For from cloudflared for client IP in the rate
# limiter and access log. Set to 0 if not behind a proxy.
PORT_TRUST_PROXY=1
